cabal-version:      2.4
name:               qutebrowser-start-page
version:            0.1.0.0
synopsis:           Generate a styled HTML start page for qutebrowser
description:        CLI tool that reads qutebrowser quickmarks, bookmarks, and history
                    to generate a responsive HTML start page with Tailwind CSS styling.
license:            MIT
author:             afreakk
maintainer:         laderud@hotmail.com
category:           Web
extra-source-files: CHANGELOG.md

executable qutebrowser-start-page
    main-is:          Main.hs
    build-depends:    base >=4.14.1.0 && <5
                    , blaze-html >=0.9 && <1
                    , sqlite-simple >=0.4 && <1
                    , unix >=2.7 && <3
                    , network-uri >=2.6 && <3
                    , directory >=1.3 && <2
    hs-source-dirs:   app
    default-language: Haskell2010
